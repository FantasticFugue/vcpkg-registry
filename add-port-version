#!/usr/bin/env bash
# Refresh the tree of an existing port version; keep its version and revision.
set -euo pipefail
[ "$#" -eq 1 ] || { echo "usage: add-port-version <port>" >&2; exit 1; }
root=$(cd "$(dirname "$0")" && pwd)
cd "$root"
python3 - "$1" <<'PY'
import json
import pathlib
import re
import subprocess
import sys

port = sys.argv[1]
if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", port):
    sys.exit("invalid port name")
manifest = json.loads(pathlib.Path(f"ports/{port}/vcpkg.json").read_text())
keys = ("version", "version-semver", "version-date", "version-string")
version = next(manifest[key] for key in keys if key in manifest)
revision = manifest.get("port-version", 0)
path = pathlib.Path(f"versions/{port[0]}-/{port}.json")
data = json.loads(path.read_text())
entries = [entry for entry in data["versions"]
           if any(entry.get(key) == version for key in keys)
           and entry.get("port-version", 0) == revision]
if len(entries) != 1:
    sys.exit("expected one existing version entry; adding versions requires user approval")
subprocess.run(["git", "add", f"ports/{port}"], check=True)
tree = subprocess.check_output(["git", "write-tree", f"--prefix=ports/{port}"], text=True).strip()
entries[0]["git-tree"] = tree
path.write_text(json.dumps(data, indent=4) + "\n")
print(f"Updated {port} {version}#{revision}: {tree}")
PY
