{
    "name": "httpant",
    "version": "0.2.0",
    "port-version": 0,
    "description": "HTTP/1.1, HTTP/2 and HTTP/3 without I/O, plus an optional asio I/O engine.",
    "homepage": "https://github.com/tsurumi-yizhou/httpant",
    "license": "MPL-2.0",
    "supports": "!(uwp|android)",
    "dependencies": [
        "asio",
        "llhttp",
        "nghttp2",
        "nghttp3",
        {
            "name": "stdexec"
        },
        {
            "name": "vcpkg-cmake",
            "host": true
        },
        {
            "name": "vcpkg-cmake-config",
            "host": true
        }
    ],
    "default-features": [],
    "features": {
        "io": {
            "description": "Build httpant.io with asio as the default backend."
        },
        "quic": {
            "description": "Build QUIC streams with msquic and engine posts (module httpant.quic).",
            "dependencies": [
                {
                    "name": "httpant",
                    "features": [
                        "io"
                    ]
                },
                "msquic"
            ]
        },
        "uring": {
            "supports": "linux",
            "description": "Build httpant.io with the Linux io_uring engine.",
            "dependencies": [
                {
                    "name": "httpant",
                    "features": [
                        "io"
                    ]
                },
                {
                    "name": "liburing",
                    "platform": "linux"
                }
            ]
        },
        "tls": {
            "description": "Build httpant.tls over caller transports with wolfSSL.",
            "dependencies": [
                "wolfssl"
            ]
        }
    }
}
